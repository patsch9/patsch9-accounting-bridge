msgstr "Lexware unterstützt über diese Schnittstelle aktuell nur EUR-Rechnungen."

#: includes/class-lexware-api-client.php:350
msgid "Order date missing."
msgstr "Bestelldatum fehlt."

#: includes/class-lexware-api-client.php:359
msgid "The order contains no billable line items."
msgstr "Die Bestellung enthält keine abrechenbaren Positionen."

#: includes/class-lexware-api-client.php:364
msgid "The name or country of the billing address is missing for the Lexware invoice."
msgstr "Für die Lexware-Rechnung fehlen Name oder Land der Rechnungsadresse."

#: includes/class-lexware-api-client.php:379
msgid "Thank you for your order."
msgstr "Vielen Dank für Ihre Bestellung."

#: includes/class-lexware-api-client.php:395
